---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { business } from '../data/business';

const { profileUrl, items } = business.reviews;
const hasReviews = items.length > 0;
const heading = 'Trusted by local customers';
const lede = 'See what customers have to say about their appliance repair experience.';

/** Deterministic monogram palette so each reviewer keeps a stable avatar colour. */
const AVATAR_COLORS = ['#1e3a8a', '#0f766e', '#7c3aed', '#b45309', '#be123c', '#0369a1'];

function initials(name: string): string {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return '?';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

function avatarColor(index: number): string {
  return AVATAR_COLORS[index % AVATAR_COLORS.length];
}
---

<section class="section section-soft">
  <div class="container">
    <SectionHeading eyebrow="Reviews" title={heading} lede={lede} />

    {hasReviews ? (
      <div class="review-layout">
        <ul class="review-list" tabindex="0" aria-label="Customer reviews">
          {items.map((review, index) => (
            <li class="review-item">
              <div
                class="review-item__stars"
                aria-label={`${review.rating} out of 5 stars`}
              >
                {Array.from({ length: 5 }).map((_, index) => (
                  <Icon
                    name="star"
                    size={16}
                    class={index < review.rating ? 'star is-on' : 'star'}
                  />
                ))}
              </div>
              <blockquote>{review.text}</blockquote>
              <div class="review-item__author">
                <span
                  class="review-item__avatar"
                  style={`--avatar-bg: ${avatarColor(index)}`}
                  aria-hidden="true"
                >
                  {review.avatar ? (
                    <img
                      src={review.avatar}
                      alt=""
                      width="40"
                      height="40"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    initials(review.author)
                  )}
                </span>
                <span class="review-item__meta">
                  <span class="review-item__name">{review.author}</span>
                  {review.relativeDate && (
                    <span class="review-item__date">{review.relativeDate}</span>
                  )}
                </span>
              </div>
            </li>
          ))}
        </ul>

        {profileUrl && (
          <div class="review-actions">
            <Button
              href={profileUrl}
              variant="secondary"
              icon="external-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Read reviews on Google
            </Button>
          </div>
        )}
      </div>
    ) : (
      <div class="review-placeholder">
        <span class="review-placeholder__icon" aria-hidden="true">
          <Icon name="star" size={22} />
        </span>
        <p class="review-placeholder__label">Placeholder — verified Google reviews</p>
        <p class="review-placeholder__copy">
          We’re gathering genuine customer feedback for PAS Appliance Repair. Real Google review
          excerpts — with reviewer names and ratings — will be published here once supplied.
        </p>
        {profileUrl ? (
          <Button
            href={profileUrl}
            variant="secondary"
            icon="external-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Read reviews on Google
          </Button>
        ) : (
          <p class="review-placeholder__note">
            A link to our Google Business Profile will be added when it’s available.
          </p>
        )}
      </div>
    )}
  </div>
</section>

<style>
  /* Horizontally scrollable row of review cards (swipe on touch, scroll on desktop). */
  .review-list {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-3);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(16.5rem, 21rem);
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .review-list:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: var(--space-2);
    border-radius: var(--radius-md);
  }

  .review-item {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .review-item__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-border-strong);
  }

  .review-item__stars .is-on {
    color: #f59e0b;
    fill: currentColor;
  }

  .review-item blockquote {
    margin: 0;
    color: var(--color-body);
    line-height: var(--leading-body);
  }

  .review-item__author {
    margin: auto 0 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .review-item__avatar {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    overflow: hidden;
    background: var(--avatar-bg, var(--color-primary));
    color: var(--color-white);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .review-item__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review-item__meta {
    display: grid;
    line-height: 1.2;
  }

  .review-item__name {
    font-size: var(--font-size-sm);
    font-weight: 650;
    color: var(--color-navy);
  }

  .review-item__date {
    margin-top: 0.15rem;
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-muted);
  }

  .review-actions {
    margin-top: var(--space-5);
  }

  .review-placeholder {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-white);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    max-width: var(--container-narrow);
  }

  .review-placeholder__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .review-placeholder__label {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .review-placeholder__copy {
    margin: 0;
    color: var(--color-body);
    line-height: var(--leading-body);
    max-width: 60ch;
  }

  .review-placeholder__note {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }
</style>
