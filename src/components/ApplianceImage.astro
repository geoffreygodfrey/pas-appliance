---
import { pexelsSrcset, pexelsUrl, aspectToRatio, type ImageAsset } from '../data/images';
import Icon from './Icon.astro';

interface Props {
  asset: ImageAsset;
  /** Display aspect ratio as CSS value, e.g. "3 / 2", "1 / 1". */
  aspect?: string;
  /** Widths for the responsive srcset. */
  widths?: number[];
  /** Optional explicit fixed pixel dimensions (disables the aspect-ratio box). */
  width?: number;
  height?: number;
  /** LCP images should stay eager; everything else lazy. */
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  sizes?: string;
  /** Small label shown on the fallback surface if the remote image fails. */
  fallbackLabel?: string;
}

const {
  asset,
  aspect = '3 / 2',
  widths = [480, 768, 1080, 1440],
  width,
  height,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
  sizes = '100vw',
  fallbackLabel,
} = Astro.props;

const bodyWidth = width ?? 1440;
const bodyHeight = height ?? Math.round(bodyWidth * aspectToRatio(aspect));
const style = height
  ? `width:${width}px;height:${height}px;`
  : `--ar:${aspect}`;
const ratio = aspectToRatio(aspect);
---

<div class={`image-wrap ${className}`} style={style}>
  <div class="image-wrap__fallback" aria-hidden="true">
    <Icon name="wrench" size={26} strokeWidth={1.6} />
    {fallbackLabel && <span>{fallbackLabel}</span>}
  </div>
  <img
    src={pexelsUrl(asset, Math.min(1200, bodyWidth), Math.round(Math.min(1200, bodyWidth) * ratio))}
    srcset={pexelsSrcset(asset, widths, ratio)}
    sizes={sizes}
    alt={asset.alt}
    width={bodyWidth}
    height={bodyHeight}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    onerror="this.style.display='none';"
  />
</div>

<style>
  .image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
    aspect-ratio: var(--ar, 3 / 2);
  }

  .image-wrap[style*="width"] {
    aspect-ratio: auto;
    max-width: 100%;
  }

  .image-wrap__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: var(--space-2);
    justify-items: center;
    color: var(--color-muted);
    font-size: var(--font-size-xs);
    background: linear-gradient(135deg, var(--color-primary-soft), var(--color-bg-soft) 60%);
    border: 1px dashed var(--color-border-strong);
  }

  .image-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>