---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business } from '../data/business';
import { services } from '../data/services';

const year = new Date().getFullYear();
const phone = business.phone;
const email = business.email;

const serviceLinks = services.map((service) => ({
  label: service.navLabel,
  href: `/${service.slug}/`,
}));
const companyLinks = [
  { label: business.nav.about, href: '/about/' },
  { label: business.nav.serviceAreas, href: '/service-areas/' },
  { label: business.nav.book, href: '/book-repair/' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo variant="dark" height="3.5rem" showName />
      <p class="footer-about">
        Appliance repair based in Brampton, Ontario, serving Brampton and surrounding GTA
        communities. Fridge, washer, dryer, stove and dishwasher repair — request service and
        describe the problem in your own words.
      </p>
    </div>

    <nav class="footer-col" aria-label="Appliance services">
      <h2>Services</h2>
      <ul>
        {serviceLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Company">
      <h2>Company</h2>
      <ul>
        {companyLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-col footer-contact">
      <h2>Contact</h2>
      <ul>
        <li>
          <a href={phone.href}>
            <Icon name="phone-call" size={16} /> {phone.display}
          </a>
        </li>
        <li>
          <a href={email.href}>
            <Icon name="mail" size={16} /> {email.display}
          </a>
        </li>
        <li class="footer-market">
          <Icon name="map-pin" size={16} /> {business.base}
        </li>
        <li class="footer-market">
          <Icon name="map-pin" size={16} /> Serving {business.market}
        </li>
      </ul>

      <div class="footer-socials">
        <span class="footer-socials__label">Follow us</span>
        <div class="footer-socials__links">
          <a
            class="footer-socials__link"
            href={business.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="PAS Appliance Repair on Instagram"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              />
            </svg>
          </a>
          <a
            class="footer-socials__link"
            href={business.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="PAS Appliance Repair on Facebook"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom__inner">
      <p>
        © {year} {business.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: rgb(255 255 255 / 0.82);
    margin-top: var(--space-8);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--space-6);
  }

  .footer-brand {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .footer-about {
    margin: 0;
    color: rgb(255 255 255 / 0.72);
    font-size: var(--font-size-sm);
    line-height: var(--leading-body);
    max-width: 38ch;
  }

  .footer-col h2 {
    color: var(--color-white);
    font-size: 1rem;
    font-weight: 650;
    margin-bottom: var(--space-4);
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: rgb(255 255 255 / 0.82);
    text-decoration: none;
    transition: color var(--ease-fast);
  }

  .footer-col a:hover {
    color: var(--color-white);
  }

  .footer-market {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    line-height: var(--leading-snug);
  }

  .footer-market svg {
    flex: none;
    margin-top: 0.2rem;
    color: rgb(255 255 255 / 0.6);
  }

  .footer-contact svg {
    color: rgb(255 255 255 / 0.6);
  }

  .footer-contact a svg {
    color: #7cb2ff;
  }

  .footer-socials {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .footer-socials__label {
    display: block;
    margin-bottom: var(--space-3);
    font-size: var(--font-size-xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }

  .footer-socials__links {
    display: flex;
    gap: var(--space-3);
  }

  .footer-socials__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    color: rgb(255 255 255 / 0.8);
    transition:
      color var(--ease-fast),
      border-color var(--ease-fast),
      background var(--ease-fast);
  }

  .footer-socials__link svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .footer-socials__link:hover {
    color: var(--color-white);
    border-color: rgb(255 255 255 / 0.45);
  }

  .footer-bottom {
    border-top: 1px solid rgb(255 255 255 / 0.12);
    padding-block: var(--space-5);
  }

  .footer-bottom p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: rgb(255 255 255 / 0.6);
  }

  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.25fr;
    }
  }
</style>
