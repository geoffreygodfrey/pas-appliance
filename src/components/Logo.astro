---
interface Props {
  /** Light/dark surface treatment for the optional wordmark. */
  variant?: 'light' | 'dark';
  class?: string;
  tag?: 'span' | 'a';
  href?: string;
  /** Rendered logo height, e.g. "3rem". Defaults to 2.75rem. */
  height?: string;
  /** Show the brand name and tagline beside the logo image. */
  showName?: boolean;
}

const {
  variant = 'light',
  class: className = '',
  tag = 'span',
  href,
  height = '2.75rem',
  showName = false,
} = Astro.props;

const classes = ['logo', `logo--${variant}`, className].filter(Boolean).join(' ');
const Tag = tag;
---

<Tag href={href} class={classes} style={`--logo-h: ${height}`}>
  <img
    class="logo__img"
    src="/logo.svg"
    alt="PAS Appliance Repair"
    width="715"
    height="715"
    decoding="async"
  />
  {
    showName && (
      <span class="logo__word">
        <span class="logo__name">PAS Appliance Repair</span>
        <span class="logo__tag">Brampton &amp; the GTA</span>
      </span>
    )
  }
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-navy);
  }

  .logo--dark {
    color: var(--color-white);
  }

  .logo__img {
    display: block;
    height: var(--logo-h, 2.75rem);
    width: auto;
    flex: none;
    border-radius: var(--radius-sm);
    background: var(--color-white);
  }

  .logo__word {
    display: grid;
    line-height: 1.1;
  }

  .logo__name {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: currentColor;
  }

  .logo__tag {
    margin-top: 0.2rem;
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-muted);
  }

  .logo--dark .logo__tag {
    color: rgb(255 255 255 / 0.65);
  }
</style>
