---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ApplianceImage from '../components/ApplianceImage.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { business } from '../data/business';
import { IMAGES } from '../data/images';

const title = 'About Us | PAS Appliance Repair — Brampton & the GTA';
const description =
  'Learn how PAS Appliance Repair approaches appliance diagnosis, estimates and service across Brampton and the GTA.';
---

<BaseLayout title={title} description={description} ogImage={IMAGES.aboutTechnician}>
  <Hero
    kicker="About"
    title="A clear, honest approach to appliance repair"
    subtitle="PAS Appliance Repair is based in Brampton, Ontario, and helps households across the GTA with fridge, washer, dryer, stove and dishwasher problems — with the process explained before anything happens."
  />

  <section class="section">
    <div class="container about-grid">
      <div class="about-media">
        <ApplianceImage
          asset={IMAGES.aboutTechnician}
          aspect="4 / 5"
          widths={[480, 768]}
          sizes="(min-width: 48rem) 420px, 100vw"
        />
      </div>
      <div class="about-copy">
        <SectionHeading
          eyebrow="Who we are"
          title="Built around straightforward service"
          lede="PAS Appliance Repair is based in Brampton, Ontario, and helps households across the GTA with fridge, washer, dryer, stove and dishwasher problems — with the next step explained clearly before anything happens."
        />
        <p>
          The core idea is simple: when a household appliance stops working properly, homeowners
          should be able to describe what is happening in their own words and get a clear,
          explained next step — without needing a technical diagnosis first.
        </p>
        <p>
          That is how every part of this site works. The request form asks for the essentials and
          nothing more. The diagnostic process, applicable fees and the repair estimate are
          discussed and confirmed before any work proceeds.
        </p>
        <ul class="check-list">
          <li><Icon name="circle-check-big" size={20} aria-hidden="true" /> Coverage confirmed for your community before a visit</li>
          <li><Icon name="circle-check-big" size={20} aria-hidden="true" /> Fees and estimates agreed before repair work</li>
          <li><Icon name="circle-check-big" size={20} aria-hidden="true" /> Plain-language explanations at every step</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <SectionHeading
        eyebrow="How diagnosis works"
        title="Diagnosis & estimates, explained"
        lede="Here’s how a service visit works, from the first symptom you describe to the estimate you approve."
      />
      <div class="about-steps">
        <div>
          <Icon name="clipboard-list" size={22} aria-hidden="true" />
          <h3>1. Describe the symptom</h3>
          <p>You tell us what the appliance is doing. One symptom can have several causes, so we do not assume a failed part ahead of inspection.</p>
        </div>
        <div>
          <Icon name="search" size={22} aria-hidden="true" />
          <h3>2. Inspect the appliance</h3>
          <p>The unit is inspected on site. We explain what we find in plain language before proposing anything.</p>
        </div>
        <div>
          <Icon name="circle-dollar-sign" size={22} aria-hidden="true" />
          <h3>3. Agree the estimate</h3>
          <p>The applicable diagnostic fee and the repair estimate are confirmed with you before work proceeds — nothing happens without your approval.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container-tight">
      <div class="about-cta">
        <h2>Questions? Get in touch.</h2>
        <p>
          If anything on this page raises a question, the request form and phone line are the
          place to start.
        </p>
        <div class="about-cta__actions">
          <Button href="/book-repair/" iconRight="arrow-right" ariaLabel={business.cta.primary}>
            {business.cta.primary}
          </Button>
          <Button href={business.phone.href} variant="secondary" icon="phone-call">
            {business.cta.secondary}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .about-media {
    position: relative;
  }

  .about-media__badge {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
  }

  .about-copy {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .about-copy p {
    margin: 0;
  }

  .about-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .about-steps > div {
    padding: 0;
  }

  .about-steps svg {
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .about-steps h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
  }

  .about-steps p {
    margin: 0;
    font-size: var(--font-size-body);
    color: var(--color-muted);
    line-height: var(--leading-body);
  }

  @media (min-width: 40rem) {
    .about-steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 56rem) {
    .about-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--space-8);
    }
  }

  .about-cta {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
  }

  .about-cta h2 {
    font-size: var(--font-size-h3);
  }

  .about-cta p {
    color: var(--color-muted);
  }

  .about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>